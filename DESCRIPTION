Package: saferTool
Type: Package
Title: Basic Tools for Object Analysis and Object Modification
Version: 1.2.0
Date: 2026-10-24
Authors@R: c(
    person(given = "Haiding", family = "Wang", role = "ctb"),
    person(given = "Yushi", family = "Han", role = "ctb"),
    person(given = "Mia", family = "Legras", role = "ctb"),
    person(given = "Gael", family = "Millot",  email = "gael.millot@pasteur.fr", role = c("aut", "cre"), comment = c(ORCID = "0000-0002-0591-3509"))
